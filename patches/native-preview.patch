@@ -0,0 +1,60 @@
+import Foundation
+
+var checks = 0
+func check(_ condition: @autoclosure () -> Bool, _ message: String) {
+    precondition(condition(), message)
+    checks += 1
+}
+
+for name in ["payments.getPaymentForm", "payments.getPaymentFormX", "payments.sendStarsForm", "payments.sendPaymentForm", "payments.sendStarsGift", "payments.transferStarGift", "payments.convertStarGift", "payments.upgradeStarGift", "payments.updateStarGiftPrice", "payments.refundStarsCharge", "payments.assignAppStoreTransaction", "payments.changeStarsSubscription", "payments.newUnrecognizedMutation", "messages.sendPaidReaction", "phone.joinGroupCallStars"] {
+    check(LocalDemoPolicy.blocks(functionName: name), "Must block financial mutation: \(name)")
+}
+for name in ["payments.getStarsStatus", "payments.getStarsTransactions", "payments.getStarGifts", "payments.getResaleStarGifts", "payments.getSavedStarGifts", "payments.checkGiftCode", "payments.searchStarGifts", "payments.resolveStarGiftOffer", "auth.sendCode", "auth.signIn", "users.getFullUser", "messages.getHistory", "messages.sendMessage", "messages.sendMedia", "messages.forwardMessages", "account.updateEmojiStatus"] {
+    check(!LocalDemoPolicy.blocks(functionName: name), "Must preserve ordinary/read-only request: \(name)")
+}
+check(LocalDemoPolicy.blocks(functionName: "messages.sendMessage", paidStars: 1), "Paid messages blocked")
+check(LocalDemoPolicy.blocks(functionName: "messages.sendMedia", paidStars: 100), "Paid media blocked")
+check(!LocalDemoPolicy.blocks(functionName: "messages.sendMessage", paidStars: 0), "Free message preserved")
+check(!LocalDemoPolicy.hasPaidAmount(nil), "Absent paid amount preserved")
+check(!LocalDemoPolicy.hasPaidAmount(Int64(0)), "Zero paid amount preserved")
+check(LocalDemoPolicy.hasPaidAmount(Int64(1)), "Integer paid amount blocked")
+check(LocalDemoPolicy.hasPaidAmount(UInt64.max), "Unsigned overflow cannot authorize a payment")
+let boxedAbsent: Int64? = nil
+let boxedPaid: Int64? = 2
+check(!LocalDemoPolicy.hasPaidAmount(boxedAbsent as Any), "Boxed nil stays free")
+check(LocalDemoPolicy.hasPaidAmount(boxedPaid as Any), "Boxed paid amount blocked")
+check(LocalDemoPolicy.hasPaidAmount("unknown"), "Unknown metadata fails closed")
+
+let suiteName = "stargram.native.policy.test." + UUID().uuidString
+let defaults = UserDefaults(suiteName: suiteName)!
+check(LocalDemoBalanceStore.balance(accountId: 1, defaults: defaults) == 9_999_999, "Default local balance")
+check(LocalDemoBalanceStore.add(accountId: 1, amount: 1, defaults: defaults) == 10_000_000, "Local credit")
+check(LocalDemoBalanceStore.balance(accountId: 2, defaults: defaults) == 9_999_999, "Accounts isolated")
+check(LocalDemoBalanceStore.balance(accountId: 1, defaults: UserDefaults(suiteName: suiteName)!) == 10_000_000, "Balance persists")
+check(LocalDemoBalanceStore.add(accountId: 1, amount: Int64.max, defaults: defaults) == LocalDemoPolicy.maximumStarsBalance, "Positive overflow bounded")
+check(LocalDemoBalanceStore.add(accountId: 1, amount: Int64.min, defaults: defaults) == 0, "Negative balance bounded")
+check(LocalDemoBalanceStore.add(accountId: 1, amount: -1, defaults: defaults) == 0, "No negative balance")
+check(LocalDemoBalanceStore.add(accountId: 1, amount: 5, defaults: defaults) == 5, "Store remains usable")
+defaults.removePersistentDomain(forName: suiteName)
+
+let scratch = FileManager.default.temporaryDirectory.appendingPathComponent("stargram-native-storage-test-" + UUID().uuidString, isDirectory: true)
+let preservedGroup = scratch.appendingPathComponent("existing-group", isDirectory: true)
+let grouped = try NativePreviewStorage.resolve(groupURL: preservedGroup, privateRootURL: scratch, allowPrivateContainer: true)
+check(grouped.url == preservedGroup && !grouped.usesPrivateContainer, "An existing group container is preserved")
+check(!FileManager.default.fileExists(atPath: scratch.path), "Resolving a group never writes to it")
+do {
+    _ = try NativePreviewStorage.resolve(groupURL: nil, privateRootURL: scratch, allowPrivateContainer: false)
+    preconditionFailure("Private fallback must require explicit preview mode")
+} catch {
+    checks += 1
+}
+let standalone = try NativePreviewStorage.resolve(groupURL: nil, privateRootURL: scratch, allowPrivateContainer: true)
+check(standalone.usesPrivateContainer && standalone.url.lastPathComponent == "StargramNative", "Standalone container stays under the app's private root")
+check(standalone.url.deletingLastPathComponent().standardizedFileURL == scratch.standardizedFileURL, "No path outside the private root")
