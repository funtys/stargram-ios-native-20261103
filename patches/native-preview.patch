+++ b/NativePreview/artifact.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+"""Validate a freshly built native Apple archive before presenting it as an artifact."""
+import argparse
+import hashlib
+import json
+from pathlib import Path, PurePosixPath
+import plistlib
+import struct
+import zipfile
+
+
+def macho_platform(binary):
+    if len(binary) < 32 or binary[:4] != b"\xcf\xfa\xed\xfe":
+        raise ValueError("Expected a 64-bit little-endian Mach-O executable")
+    header = struct.unpack_from("<8I", binary)
+    if header[1] != 0x0100000C:
+        raise ValueError("The app executable is not arm64")
+    cursor = 32
+    for _ in range(header[4]):
+        if cursor + 8 > len(binary):
+            raise ValueError("Truncated Mach-O load command")
+        command, size = struct.unpack_from("<2I", binary, cursor)
+        if size < 8 or cursor + size > len(binary):
+            raise ValueError("Invalid Mach-O load command size")
+        if command == 0x32 and size >= 24:
+            return struct.unpack_from("<I", binary, cursor + 8)[0]
+        cursor += size
+    raise ValueError("Missing LC_BUILD_VERSION platform identifier")
+
+
+def validate(archive, target, unsigned):
+    with zipfile.ZipFile(archive) as bundle:
+        for entry in bundle.namelist():
+            path = PurePosixPath(entry)
+            if path.is_absolute() or ".." in path.parts or "\\" in entry:
+                raise ValueError("Archive contains an unsafe file path")
+        if bundle.testzip() is not None:
+            raise ValueError("The built archive is corrupt")
+        plists = [name for name in bundle.namelist() if len(PurePosixPath(name).parts) == 3 and name.startswith("Payload/") and name.endswith(".app/Info.plist")]
+        if len(plists) != 1:
+            raise ValueError("Expected exactly one main app under Payload/")
+        plist = plistlib.loads(bundle.read(plists[0]))
+        root = plists[0].removesuffix("Info.plist")
+        executable = plist.get("CFBundleExecutable", "")
+        if not executable or "/" in executable or executable in (".", ".."):
+            raise ValueError("Invalid app executable name")
+        actual_platform = macho_platform(bundle.read(root + executable))
+        expected_platform = 2 if target == "iphone" else 7
+        if actual_platform != expected_platform:
+            raise ValueError("Wrong archive platform: iPhone and simulator artifacts cannot be interchanged")
+        if unsigned:
+            if root + "embedded.mobileprovision" in bundle.namelist():
+                raise ValueError("An unsigned artifact must not include a personal provisioning profile")
+            if any(name.startswith(root + "PlugIns/") and ".appex/" in name for name in bundle.namelist()):
+                raise ValueError("Standalone sideload preview unexpectedly includes extensions")
+        return {
+            "archive": Path(archive).name,
+            "sha256": hashlib.sha256(Path(archive).read_bytes()).hexdigest(),
+            "bytes": Path(archive).stat().st_size,
+            "target": target,
+            "macho_platform": actual_platform,
+            "bundle_id": plist.get("CFBundleIdentifier"),
+            "version": plist.get("CFBundleShortVersionString"),
+            "signing_required_before_install": unsigned,
+            "device_execution_verified": False,
+        }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("archive", type=Path)
+    parser.add_argument("--target", choices=["iphone", "simulator"], required=True)
+    parser.add_argument("--unsigned", action="store_true")
+    parser.add_argument("--output", type=Path)
+    args = parser.parse_args()
+    if args.unsigned and args.target != "iphone":
+        raise ValueError("Only an iPhone artifact can be exported for re-signing")
+    report = validate(args.archive, args.target, args.unsigned)
+    text = json.dumps(report, indent=2) + "\n"
+    if args.output:
+        args.output.write_text(text, encoding="utf-8")
+    print(text)
+
+
+if __name__ == "__main__":
+    main()
