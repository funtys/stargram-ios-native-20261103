+import Foundation
+
+var checks = 0
+func check(_ condition: @autoclosure () -> Bool, _ message: String) {
+    precondition(condition(), message)
+    checks += 1
+}
+
+for name in ["payments.getPaymentForm", "payments.getPaymentFormX", "payments.sendStarsForm", "payments.sendPaymentForm", "payments.sendStarsGift", "payments.transferStarGift", "payments.convertStarGift", "payments.upgradeStarGift", "payments.updateStarGiftPrice", "payments.refundStarsCharge", "payments.assignAppStoreTransaction", "payments.changeStarsSubscription", "payments.newUnrecognizedMutation", "messages.sendPaidReaction", "phone.joinGroupCallStars"] {
+    check(LocalDemoPolicy.blocks(functionName: name), "Must block financial mutation: \(name)")
+}
+for name in ["payments.getStarsStatus", "payments.getStarsTransactions", "payments.getStarGifts", "payments.getResaleStarGifts", "payments.getSavedStarGifts", "payments.checkGiftCode", "payments.searchStarGifts", "payments.resolveStarGiftOffer", "auth.sendCode", "auth.signIn", "users.getFullUser", "messages.getHistory", "messages.sendMessage", "messages.sendMedia", "messages.forwardMessages", "account.updateEmojiStatus"] {
+    check(!LocalDemoPolicy.blocks(functionName: name), "Must preserve ordinary/read-only request: \(name)")
+}
+check(LocalDemoPolicy.blocks(functionName: "messages.sendMessage", paidStars: 1), "Paid messages blocked")
+check(LocalDemoPolicy.blocks(functionName: "messages.sendMedia", paidStars: 100), "Paid media blocked")
+check(!LocalDemoPolicy.blocks(functionName: "messages.sendMessage", paidStars: 0), "Free message preserved")
+check(!LocalDemoPolicy.hasPaidAmount(nil), "Absent paid amount preserved")
+check(!LocalDemoPolicy.hasPaidAmount(Int64(0)), "Zero paid amount preserved")
+check(LocalDemoPolicy.hasPaidAmount(Int64(1)), "Integer paid amount blocked")
+check(LocalDemoPolicy.hasPaidAmount(UInt64.max), "Unsigned overflow cannot authorize a payment")
+let boxedAbsent: Int64? = nil
+let boxedPaid: Int64? = 2
+check(!LocalDemoPolicy.hasPaidAmount(boxedAbsent as Any), "Boxed nil stays free")
+check(LocalDemoPolicy.hasPaidAmount(boxedPaid as Any), "Boxed paid amount blocked")
+check(LocalDemoPolicy.hasPaidAmount("unknown"), "Unknown metadata fails closed")
+
+let suiteName = "stargram.native.policy.test." + UUID().uuidString
+let defaults = UserDefaults(suiteName: suiteName)!
+check(LocalDemoBalanceStore.balance(accountId: 1, defaults: defaults) == 9_999_999, "Default local balance")
+check(LocalDemoBalanceStore.add(accountId: 1, amount: 1, defaults: defaults) == 10_000_000, "Local credit")
+check(LocalDemoBalanceStore.balance(accountId: 2, defaults: defaults) == 9_999_999, "Accounts isolated")
+check(LocalDemoBalanceStore.balance(accountId: 1, defaults: UserDefaults(suiteName: suiteName)!) == 10_000_000, "Balance persists")
+check(LocalDemoBalanceStore.add(accountId: 1, amount: Int64.max, defaults: defaults) == LocalDemoPolicy.maximumStarsBalance, "Positive overflow bounded")
+check(LocalDemoBalanceStore.add(accountId: 1, amount: Int64.min, defaults: defaults) == 0, "Negative balance bounded")
+check(LocalDemoBalanceStore.add(accountId: 1, amount: -1, defaults: defaults) == 0, "No negative balance")
+check(LocalDemoBalanceStore.add(accountId: 1, amount: 5, defaults: defaults) == 5, "Store remains usable")
+let receiptCount = LocalDemoBalanceStore.receipts(accountId: 1, defaults: defaults).count
+check(LocalDemoBalanceStore.receipts(accountId: 1, defaults: defaults).first?.amount == 5, "Receipt records the credited amount")
+check(LocalDemoBalanceStore.receipts(accountId: 2, defaults: defaults).isEmpty, "Receipt accounts isolated")
+check(LocalDemoBalanceStore.receipts(accountId: 1, defaults: UserDefaults(suiteName: suiteName)!).count == receiptCount, "Receipts persist on reopen")
+check(LocalDemoBalanceStore.set(accountId: 1, amount: 5, defaults: defaults) == 5, "Same balance is a no-op")
+check(LocalDemoBalanceStore.receipts(accountId: 1, defaults: defaults).count == receiptCount, "No duplicate receipt for unchanged balance")
+check(LocalDemoBalanceStore.set(accountId: 1, amount: 105, defaults: defaults) == 105, "Manual balance edit")
+check(LocalDemoBalanceStore.receipts(accountId: 1, defaults: defaults).first?.amount == 100, "Manual increase records only the delta")
+let removedId = LocalDemoBalanceStore.receipts(accountId: 1, defaults: defaults).first!.id
+LocalDemoBalanceStore.removeReceipt(accountId: 1, id: removedId, defaults: defaults)
+check(LocalDemoBalanceStore.balance(accountId: 1, defaults: defaults) == 105, "Deleting history never changes balance")
+check(!LocalDemoBalanceStore.receipts(accountId: 1, defaults: defaults).contains(where: { $0.id == removedId }), "Deleted receipt stays removed")
+check(LocalDemoBalanceStore.set(accountId: 1, amount: 1250000000, ton: true, defaults: defaults) == 1250000000, "GRAM preserves nanoton precision")
+check(LocalDemoBalanceStore.balance(accountId: 1, defaults: defaults) == 105, "GRAM never changes Stars")
+check(LocalDemoBalanceStore.receipts(accountId: 1, ton: true, defaults: defaults).first?.amount == 1250000000, "GRAM gets its own credit receipt")
+let fakeGift = LocalDemoBalanceStore.ProfileGift(id: "local-gift-1", peerId: 99, data: Data("visible".utf8))
+check(!LocalDemoPolicy.blocks(functionName: "payments.saveStarGift"), "Profile visibility is separate from financial actions")
+let fakeReceipt = LocalDemoBalanceStore.Receipt(id: "local-gift-1", amount: -5, date: 1)
+check(LocalDemoBalanceStore.spend(accountId: 1, price: 5, ton: false, receipt: fakeReceipt, gift: fakeGift, defaults: defaults), "Gift commits balance, receipt and profile atomically")
+check(LocalDemoBalanceStore.balance(accountId: 1, defaults: defaults) == 100, "Gift deducts the selected price")
+check(!LocalDemoBalanceStore.spend(accountId: 1, price: 5, ton: false, receipt: fakeReceipt, gift: fakeGift, defaults: defaults), "One checkout token cannot be charged twice")
+check(LocalDemoBalanceStore.gifts(accountId: 1, peerId: 99, defaults: defaults).count == 1, "Gift belongs to the selected recipient")
+check(LocalDemoBalanceStore.gifts(accountId: 2, peerId: 99, defaults: defaults).isEmpty, "Profile gifts are account isolated")
+LocalDemoBalanceStore.updateGift(accountId: 1, id: fakeGift.id, data: Data("hidden".utf8), defaults: defaults)
+check(LocalDemoBalanceStore.gifts(accountId: 1, peerId: 99, defaults: UserDefaults(suiteName: suiteName)!).first?.data == Data("hidden".utf8), "Hidden state persists across reopening")
