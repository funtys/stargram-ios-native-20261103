diff --git a/submodules/TelegramCore/Sources/Network/LocalDemoPolicy.swift b/submodules/TelegramCore/Sources/Network/LocalDemoPolicy.swift
new file mode 100644
--- /dev/null
+++ b/submodules/TelegramCore/Sources/Network/LocalDemoPolicy.swift
@@ -0,0 +1,172 @@
+import Foundation
+
+/// Device-only preview settings. These values never grant server-side entitlements.
+public enum LocalDemoPolicy {
+    public static let isEnabled = true
+    public static let paymentErrorDescription = "LOCAL_PAYMENTS_DISABLED"
+    public static let defaultStarsBalance: Int64 = 9_999_999
+    public static let maximumStarsBalance: Int64 = 1_000_000_000_000
+
+    // Metadata may contain a Swift Optional boxed as Any. Unknown non-empty values
+    // must never silently authorize a paid request.
+    static func hasPaidAmount(_ value: Any?, depth: Int = 0) -> Bool {
+        guard let value else {
+            return false
+        }
+        guard depth < 8 else {
+            return true
+        }
+        if let number = value as? NSNumber {
+            return number.compare(NSNumber(value: 0)) != .orderedSame
+        }
+        let mirror = Mirror(reflecting: value)
+        if mirror.displayStyle == .optional {
+            return self.hasPaidAmount(mirror.children.first?.value, depth: depth + 1)
+        }
+        return true
+    }
+
+    public static func blocks(functionName: String, paidStars: Int64 = 0) -> Bool {
+        guard self.isEnabled else {
+            return false
+        }
+        if functionName.hasPrefix("payments.") {
+            let method = String(functionName.dropFirst("payments.".count))
+            if method == "saveStarGift" { return false }
+            if method.hasPrefix("getPaymentForm") {
+                return true
+            }
+            return !["get", "check", "search", "resolve"].contains(where: { method.hasPrefix($0) })
+        }
+        if functionName.hasPrefix("messages.sendPaid") || functionName == "phone.joinGroupCallStars" {
+            return true
+        }
+        return paidStars > 0
+    }
+}
+
+/// Stored separately for each signed-in account, inside this app's own sandbox.
+enum LocalDemoBalanceStore {
+    struct Receipt: Codable, Equatable {
+        let id: String
+        let amount: Int64
+        let date: Int32
+        var peerId: Int64? = nil
+        var gift: Data? = nil
+        var premiumMonths: Int32? = nil
+        var starsGift: Bool? = nil
+    }
+    struct ProfileGift: Codable {
+        let id: String
+        let peerId: Int64
+        var data: Data
+    }
+    private struct Ledger: Codable {
+        let balance: Int64
+        let receipts: [Receipt]
+        var gifts: [ProfileGift]? = nil
+    }
+    static let didChange = Notification.Name("StargramLocalBalanceChanged")
+    private static let lock = NSRecursiveLock()
+
+    private static func key(accountId: Int64, ton: Bool = false) -> String {
+        return "stargram.native.demo.stars.\(accountId)" + (ton ? ".ton" : "")
+    }
+    private static func ledger(accountId: Int64, ton: Bool = false, defaults: UserDefaults) -> Ledger {
+        if let data = defaults.data(forKey: self.key(accountId: accountId, ton: ton) + ".ledger"),
+           let value = try? JSONDecoder().decode(Ledger.self, from: data) {
+            return value
+        }
+        let legacy = (defaults.object(forKey: self.key(accountId: accountId, ton: ton)) as? NSNumber)?.int64Value ?? (ton ? 0 : LocalDemoPolicy.defaultStarsBalance)
+        return Ledger(balance: min(ton ? 1_000_000_000_000_000_000 : LocalDemoPolicy.maximumStarsBalance, max(0, legacy)), receipts: [])
+    }
+    static func balance(accountId: Int64, ton: Bool = false, defaults: UserDefaults = .standard) -> Int64 {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.ledger(accountId: accountId, ton: ton, defaults: defaults).balance
+    }
+    static func receipts(accountId: Int64, ton: Bool = false, defaults: UserDefaults = .standard) -> [Receipt] {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return self.ledger(accountId: accountId, ton: ton, defaults: defaults).receipts.reversed()
+    }
+    @discardableResult
+    static func set(accountId: Int64, amount: Int64, ton: Bool = false, defaults: UserDefaults = .standard) -> Int64 {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        let old = self.ledger(accountId: accountId, ton: ton, defaults: defaults)
+        let bounded = min(ton ? 1_000_000_000_000_000_000 : LocalDemoPolicy.maximumStarsBalance, max(0, amount))
+        let delta = bounded - old.balance
+        guard delta != 0 else { return bounded }
+        var receipts = old.receipts
+        receipts.append(Receipt(id: "local-" + UUID().uuidString, amount: delta, date: Int32(Date().timeIntervalSince1970)))
+        let ledger = Ledger(balance: bounded, receipts: receipts, gifts: old.gifts)
+        guard let data = try? JSONEncoder().encode(ledger) else { return old.balance }
+        defaults.set(data, forKey: self.key(accountId: accountId, ton: ton) + ".ledger")
+        NotificationCenter.default.post(name: self.didChange, object: nil, userInfo: ["accountId": accountId])
+        return bounded
+    }
+    static func removeReceipt(accountId: Int64, id: String, ton: Bool = false, defaults: UserDefaults = .standard) {
+        guard id.hasPrefix("local-") else { return }
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        let old = self.ledger(accountId: accountId, ton: ton, defaults: defaults)
+        let ledger = Ledger(balance: old.balance, receipts: old.receipts.filter { $0.id != id }, gifts: old.gifts)
+        guard let data = try? JSONEncoder().encode(ledger) else { return }
+        defaults.set(data, forKey: self.key(accountId: accountId, ton: ton) + ".ledger")
+        NotificationCenter.default.post(name: self.didChange, object: nil, userInfo: ["accountId": accountId])
+    }
+    static func add(accountId: Int64, amount: Int64, ton: Bool = false, defaults: UserDefaults = .standard) -> Int64 {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        let current = self.balance(accountId: accountId, ton: ton, defaults: defaults)
+        let (sum, overflow) = current.addingReportingOverflow(amount)
+        return self.set(accountId: accountId, amount: overflow ? (amount > 0 ? (ton ? 1_000_000_000_000_000_000 : LocalDemoPolicy.maximumStarsBalance) : 0) : sum, ton: ton, defaults: defaults)
+    }
+
+    static func gifts(accountId: Int64, peerId: Int64, defaults: UserDefaults = .standard) -> [ProfileGift] {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        return [false, true].flatMap { self.ledger(accountId: accountId, ton: $0, defaults: defaults).gifts ?? [] }
+            .filter { $0.peerId == peerId }.reversed()
+    }
+
+    @discardableResult
+    static func spend(accountId: Int64, price: Int64, ton: Bool, receipt: Receipt, gift: ProfileGift?, defaults: UserDefaults = .standard) -> Bool {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        let old = self.ledger(accountId: accountId, ton: ton, defaults: defaults)
+        guard price >= 0, price <= old.balance, receipt.amount == -price, receipt.id.hasPrefix("local-"), !old.receipts.contains(where: { $0.id == receipt.id }) else { return false }
+        var gifts = old.gifts ?? []
+        if let gift { gifts.append(gift) }
+        let next = Ledger(balance: old.balance - price, receipts: old.receipts + [receipt], gifts: gifts)
+        guard let data = try? JSONEncoder().encode(next) else { return false }
+        defaults.set(data, forKey: self.key(accountId: accountId, ton: ton) + ".ledger")
+        NotificationCenter.default.post(name: self.didChange, object: nil, userInfo: ["accountId": accountId])
+        return true
+    }
+
+    static func updateGift(accountId: Int64, id: String, data: Data, defaults: UserDefaults = .standard) {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        for ton in [false, true] {
+            var old = self.ledger(accountId: accountId, ton: ton, defaults: defaults)
+            guard let index = old.gifts?.firstIndex(where: { $0.id == id }) else { continue }
+            old.gifts?[index].data = data
+            guard let encoded = try? JSONEncoder().encode(old) else { return }
+            defaults.set(encoded, forKey: self.key(accountId: accountId, ton: ton) + ".ledger")
+            NotificationCenter.default.post(name: self.didChange, object: nil, userInfo: ["accountId": accountId])
+            return
+        }
+    }
+}
+
+public enum LocalPremiumSettings {
+    public static func isEnabled(accountId: Int64) -> Bool {
+        return UserDefaults.standard.double(forKey: "stargram.premium.\(accountId)") > Date().timeIntervalSince1970
+    }
+    public static func enable(accountId: Int64, months: Int32 = 12) {
+        UserDefaults.standard.set(Date().timeIntervalSince1970 + Double(max(1, min(12, months))) * 30 * 86400, forKey: "stargram.premium.\(accountId)")
+        NotificationCenter.default.post(name: LocalDemoBalanceStore.didChange, object: nil, userInfo: ["accountId": accountId])
+    }
+}
diff --git a/submodules/TelegramCore/Sources/Network/LocalDemoRequestGuard.swift b/submodules/TelegramCore/Sources/Network/LocalDemoRequestGuard.swift
new file mode 100644
--- /dev/null
+++ b/submodules/TelegramCore/Sources/Network/LocalDemoRequestGuard.swift
@@ -0,0 +1,19 @@
+import Foundation
+internal import TelegramApi
+
+/// Called before a request reaches either MTProto network engine.
+func localDemoBlocksRequest(_ description: FunctionDescription) -> Bool {
+    if LocalDemoPolicy.blocks(functionName: description.name) {
+        return true
+    }
+    if description.name.hasPrefix("messages.send") || description.name == "messages.forwardMessages" || description.name.hasPrefix("phone.joinGroupCall") {
+        for (name, parameter) in description.parameters {
+            if name == "allowPaidStars" || name == "allow_paid_stars" || name == "paidStars" || name == "paid_stars" {
+                if LocalDemoPolicy.hasPaidAmount(parameter.value) {
+                    return true
+                }
+            }
+        }
+    }
+    return false
+}
