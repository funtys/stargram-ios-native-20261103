diff --git a/submodules/TelegramCore/Sources/TelegramEngine/Payments/LocalGiftPayments.swift b/submodules/TelegramCore/Sources/TelegramEngine/Payments/LocalGiftPayments.swift
new file mode 100644
--- /dev/null
+++ b/submodules/TelegramCore/Sources/TelegramEngine/Payments/LocalGiftPayments.swift
@@ -0,0 +1,174 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+internal import TelegramApi
+
+/// Local checkout uses Telegram's message and profile renderers. No payment RPC is sent.
+private struct LocalGiftPaymentPlan {
+    let accountId: Int64
+    let signature: String
+    let peerId: PeerId
+    let price: Int64
+    let ton: Bool
+    let gift: StarGift?
+    let premiumMonths: Int32?
+    let stars: Int64?
+    let text: String?
+    let entities: [MessageTextEntity]?
+    let hideName: Bool
+}
+
+private enum LocalGiftPaymentForms {
+    static let lock = NSLock()
+    static var forms: [Int64: LocalGiftPaymentPlan] = [:]
+
+    static func put(_ plan: LocalGiftPaymentPlan) -> BotPaymentForm {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        var id = Int64.random(in: Int64.min ... -1)
+        while self.forms[id] != nil { id = Int64.random(in: Int64.min ... -1) }
+        if self.forms.count > 128 { self.forms.removeAll() }
+        self.forms[id] = plan
+        let invoice = BotPaymentInvoice(isTest: true, requestedFields: [], currency: plan.ton ? "TON" : "XTR", prices: [BotPaymentPrice(label: "Gift", amount: plan.price)], tip: nil, termsInfo: nil, subscriptionPeriod: nil)
+        return BotPaymentForm(id: id, canSaveCredentials: false, passwordMissing: false, invoice: invoice, paymentBotId: nil, providerId: nil, url: nil, nativeProvider: nil, savedInfo: nil, savedCredentials: [], additionalPaymentMethods: [])
+    }
+
+    static func take(id: Int64, accountId: Int64, source: BotPaymentInvoiceSource) -> LocalGiftPaymentPlan? {
+        self.lock.lock()
+        defer { self.lock.unlock() }
+        guard let plan = self.forms[id], plan.accountId == accountId, plan.signature == String(reflecting: source) else { return nil }
+        self.forms.removeValue(forKey: id)
+        return plan
+    }
+}
+
+func localGiftPaymentForm(accountPeerId: PeerId, postbox: Postbox, network: Network, source: BotPaymentInvoiceSource) -> Signal<BotPaymentForm, BotPaymentFormRequestError>? {
+    func form(peerId: PeerId, price: Int64, ton: Bool = false, gift: StarGift? = nil, months: Int32? = nil, stars: Int64? = nil, text: String? = nil, entities: [MessageTextEntity]? = nil, hideName: Bool = false) -> BotPaymentForm {
+        return LocalGiftPaymentForms.put(LocalGiftPaymentPlan(accountId: accountPeerId.toInt64(), signature: String(reflecting: source), peerId: peerId, price: price, ton: ton, gift: gift, premiumMonths: months, stars: stars, text: text, entities: entities, hideName: hideName))
+    }
+    switch source {
+    case let .starGift(hideName, includeUpgrade, peerId, giftId, text, entities):
+        return network.request(Api.functions.payments.getStarGifts(hash: 0))
+        |> mapError { _ in BotPaymentFormRequestError.generic }
+        |> mapToSignal { result -> Signal<BotPaymentForm, BotPaymentFormRequestError> in
+            guard case let .starGifts(data) = result,
+                let gift = data.gifts.compactMap({ StarGift(apiStarGift: $0) }).first(where: { if case let .generic(value) = $0 { return value.id == giftId }; return false }),
+                case let .generic(value) = gift else { return .fail(.generic) }
+            let extra = includeUpgrade ? (value.upgradeStars ?? 0) : 0
+            let (price, overflow) = value.price.addingReportingOverflow(extra)
+            guard !overflow, price >= 0 else { return .fail(.generic) }
+            return .single(form(peerId: peerId, price: price, gift: gift, text: text, entities: entities, hideName: hideName))
+        }
+    case let .starGiftResale(slug, peerId, ton, hideName, text, entities):
+        // Always read the selected market variant, never a previously purchased profile copy.
+        return network.request(Api.functions.payments.getUniqueStarGift(slug: slug))
+        |> mapError { _ in BotPaymentFormRequestError.generic }
+        |> mapToSignal { result -> Signal<BotPaymentForm, BotPaymentFormRequestError> in
+            guard case let .uniqueStarGift(data) = result, case let .unique(value) = StarGift(apiStarGift: data.gift),
+                let amount = value.resellAmounts?.first(where: { $0.currency == (ton ? .ton : .stars) }), amount.amount.value >= 0 else { return .fail(.generic) }
+            let owned = StarGift.UniqueGift(id: value.id, giftId: value.giftId, title: value.title, number: value.number, slug: value.slug, owner: .peerId(peerId), attributes: value.attributes, availability: value.availability, giftAddress: nil, resellAmounts: nil, resellForTonOnly: false, releasedBy: value.releasedBy, valueAmount: value.valueAmount, valueCurrency: value.valueCurrency, valueUsdAmount: value.valueUsdAmount, flags: value.flags, themePeerId: value.themePeerId, peerColor: value.peerColor, hostPeerId: nil, minOfferStars: nil, craftChancePermille: value.craftChancePermille)
+            return .single(form(peerId: peerId, price: amount.amount.value, ton: ton, gift: .unique(owned), text: text, entities: entities, hideName: hideName))
+        }
+    case let .premiumGift(peerId, option, text, entities):
+        return .single(form(peerId: peerId, price: option.currency == "XTR" ? option.amount : 0, months: option.months, text: text, entities: entities))
+    case let .giftCode(users, currency, amount, option, text, entities):
+        guard users.count == 1, let peerId = users.first else { return .fail(.generic) }
+        return .single(form(peerId: peerId, price: currency == "XTR" ? amount : 0, months: option.months, text: text, entities: entities))
+    case let .starsGift(peerId, count, _, _):
+        guard count > 0 else { return .fail(.generic) }
+        return .single(form(peerId: peerId, price: count, stars: count))
+    default:
+        return nil
+    }
+}
+
+func localSendGiftPayment(account: Account, formId: Int64, source: BotPaymentInvoiceSource) -> Signal<SendBotPaymentResult, SendBotPaymentFormError> {
+    guard let plan = LocalGiftPaymentForms.take(id: formId, accountId: account.peerId.toInt64(), source: source) else { return .fail(.alreadyPaid) }
+    return account.postbox.transaction { transaction -> SendBotPaymentResult? in
+        guard plan.price >= 0, plan.price <= LocalDemoBalanceStore.balance(accountId: plan.accountId, ton: plan.ton) else { return nil }
+        let date = Int32(Date().timeIntervalSince1970)
+        let receiptId = "local-gift-" + UUID().uuidString
+        let action: TelegramMediaActionType
+        if let gift = plan.gift {
+            if case .unique = gift {
+                action = .starGiftUnique(gift: gift, isUpgrade: false, isTransferred: false, savedToProfile: true, canExportDate: nil, transferStars: nil, isRefunded: false, isPrepaidUpgrade: false, peerId: nil, senderId: nil, savedId: nil, resaleAmount: nil, canTransferDate: nil, canResaleDate: nil, dropOriginalDetailsStars: nil, assigned: false, fromOffer: false, canCraftAt: nil, isCrafted: false, text: plan.text, entities: plan.entities, nameHidden: plan.hideName)
+            } else {
+                action = .starGift(gift: gift, convertStars: nil, text: plan.text, entities: plan.entities, nameHidden: plan.hideName, savedToProfile: true, converted: false, upgraded: false, canUpgrade: false, upgradeStars: nil, isRefunded: false, isPrepaidUpgrade: false, upgradeMessageId: nil, peerId: nil, senderId: nil, savedId: nil, prepaidUpgradeHash: nil, giftMessageId: nil, upgradeSeparate: false, isAuctionAcquired: false, toPeerId: plan.peerId, number: nil)
+            }
+        } else if let months = plan.premiumMonths {
+            action = .giftPremium(currency: "XTR", amount: plan.price, days: max(1, min(12, months)) * 30, cryptoCurrency: nil, cryptoAmount: nil, text: plan.text, entities: plan.entities)
+        } else if let stars = plan.stars {
+            action = .giftStars(currency: "XTR", amount: plan.price, count: stars, cryptoCurrency: nil, cryptoAmount: nil, transactionId: receiptId)
+        } else { return nil }
+
+        let randomId = Int64.random(in: Int64.min ... Int64.max)
+        // A sent local service message is never enqueued to PendingMessageManager.
+        let message = StoreMessage(peerId: plan.peerId, namespace: Namespaces.Message.Local, customStableId: nil, globallyUniqueId: randomId, groupingKey: nil, threadId: nil, timestamp: date, flags: [], tags: [], globalTags: [], localTags: [], forwardInfo: nil, authorId: account.peerId, text: "", attributes: [], media: [TelegramMediaAction(action: action)])
+        let ids = transaction.addMessages([message], location: .Random)
+        guard let messageId = ids[randomId] else { return nil }
+        var saved: ProfileGiftsContext.State.StarGift?
+        if let gift = plan.gift {
+            saved = ProfileGiftsContext.State.StarGift(gift: gift, reference: .message(messageId: messageId), fromPeer: transaction.getPeer(account.peerId).map(EnginePeer.init), date: date, text: plan.text, entities: plan.entities, nameHidden: plan.hideName, savedToProfile: true, pinnedToTop: false, convertStars: nil, canUpgrade: false, canExportDate: nil, upgradeStars: nil, transferStars: nil, canTransferDate: nil, canResaleDate: nil, collectionIds: nil, prepaidUpgradeHash: nil, upgradeSeparate: false, dropOriginalDetailsStars: nil, number: nil, isRefunded: false, canCraftAt: nil)
+        }
+        let savedData = saved.flatMap { try? JSONEncoder().encode($0) }
+        var receipt = LocalDemoBalanceStore.Receipt(id: receiptId, amount: -plan.price, date: date)
+        receipt.peerId = plan.peerId.toInt64()
+        receipt.gift = plan.gift.flatMap { try? JSONEncoder().encode($0) }
+        receipt.premiumMonths = plan.premiumMonths
+        receipt.starsGift = plan.stars != nil
+        let entry = savedData.map { LocalDemoBalanceStore.ProfileGift(id: receiptId, peerId: plan.peerId.toInt64(), data: $0) }
+        guard LocalDemoBalanceStore.spend(accountId: plan.accountId, price: plan.price, ton: plan.ton, receipt: receipt, gift: entry) else {
+            transaction.deleteMessages([messageId], forEachMedia: nil)
+            return nil
+        }
+        if saved != nil {
+            transaction.updatePeerCachedData(peerIds: [plan.peerId], update: { _, data in
+                if let data = data as? CachedUserData { return data.withUpdatedStarGiftsCount(max(1, data.starGiftsCount ?? 0)) }
+                return data
+            })
+        }
+        return .done(receiptMessageId: messageId, subscriptionPeerId: nil, uniqueStarGift: saved)
+    }
+    |> castError(SendBotPaymentFormError.self)
+    |> mapToSignal { result -> Signal<SendBotPaymentResult, SendBotPaymentFormError> in
+        guard let result else { return .fail(.paymentFailed) }
+        return .single(result)
+    }
+}
+
+public func localStorePurchase(account: Account, purpose: AppStoreTransactionPurpose, premiumMonths: Int32) -> Signal<SendBotPaymentResult, SendBotPaymentFormError> {
+    let peerId: PeerId
+    let stars: Int64?
+    let months: Int32?
+    let text: String?
+    let entities: [MessageTextEntity]?
+    switch purpose {
+    case .subscription, .upgrade, .restore:
+        LocalPremiumSettings.enable(accountId: account.peerId.toInt64(), months: premiumMonths)
+        return .single(.done(receiptMessageId: nil, subscriptionPeerId: nil, uniqueStarGift: nil))
+    case .stars:
+        // StarsPurchaseScreen's completion updates StarsContext once and persists its receipt.
+        return .single(.done(receiptMessageId: nil, subscriptionPeerId: nil, uniqueStarGift: nil))
+    case let .starsGift(id, count, _, _):
+        guard count > 0 else { return .fail(.generic) }
+        peerId = id; stars = count; months = nil; text = nil; entities = nil
+    case let .gift(id, _, _):
+        peerId = id; stars = nil; months = premiumMonths; text = nil; entities = nil
+    case let .giftCode(ids, _, _, _, message, messageEntities):
+        guard ids.count == 1, let id = ids.first else { return .fail(.generic) }
+        peerId = id; stars = nil; months = premiumMonths; text = message; entities = messageEntities
+    default:
+        return .fail(.generic)
+    }
+    let source = BotPaymentInvoiceSource.slug("local-store-" + UUID().uuidString)
+    let plan = LocalGiftPaymentPlan(accountId: account.peerId.toInt64(), signature: String(reflecting: source), peerId: peerId, price: stars ?? 0, ton: false, gift: nil, premiumMonths: months, stars: stars, text: text, entities: entities, hideName: false)
+    let form = LocalGiftPaymentForms.put(plan)
+    return localSendGiftPayment(account: account, formId: form.id, source: source)
+}
+
+public func localProfileGiftCount(accountId: Int64, peerId: Int64) -> Int {
+    return LocalDemoBalanceStore.gifts(accountId: accountId, peerId: peerId).filter { entry in
+        guard let gift = try? JSONDecoder().decode(ProfileGiftsContext.State.StarGift.self, from: entry.data) else { return false }
+        return accountId == peerId || gift.savedToProfile
+    }.count
+}
