diff --git a/submodules/TelegramUI/Sources/NativePreviewStorage.swift b/submodules/TelegramUI/Sources/NativePreviewStorage.swift
new file mode 100644
--- /dev/null
+++ b/submodules/TelegramUI/Sources/NativePreviewStorage.swift
@@ -0,0 +1,20 @@
+import Foundation
+
+/// Uses the existing group when available; a standalone preview stays in its own app sandbox.
+enum NativePreviewStorage {
+    enum StorageError: Error {
+        case unavailable
+    }
+
+    static func resolve(groupURL: URL?, privateRootURL: URL?, allowPrivateContainer: Bool) throws -> (url: URL, usesPrivateContainer: Bool) {
+        if let groupURL {
+            return (groupURL, false)
+        }
+        guard allowPrivateContainer, let privateRootURL, privateRootURL.isFileURL else {
+            throw StorageError.unavailable
+        }
+        let directory = privateRootURL.appendingPathComponent("StargramNative", isDirectory: true)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        return (directory, true)
+    }
+}
