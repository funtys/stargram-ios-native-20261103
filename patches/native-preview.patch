new file mode 100644
--- /dev/null
+++ b/NativePreview/manage.py
@@ -0,0 +1,172 @@
+#!/usr/bin/env python3
+"""Configure and build the native iPhone preview without handling account sessions."""
+import argparse
+import json
+import os
+from pathlib import Path
+import platform
+import re
+import shlex
+import shutil
+import subprocess
+import sys
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+HERE = Path(__file__).resolve().parent
+CONFIG = HERE / "configuration.local.json"
+
+
+def read_config():
+    source = CONFIG if CONFIG.is_file() else HERE / "configuration.example.json"
+    return json.loads(source.read_text(encoding="utf-8-sig"))
+
+
+def valid_credentials(config):
+    return str(config.get("api_id", "")).isdigit() and int(config["api_id"]) > 0 and bool(re.fullmatch(r"[a-fA-F0-9]{32}", str(config.get("api_hash", ""))))
+
+
+def valid_team(config):
+    value = config.get("team_id", "")
+    return bool(re.fullmatch(r"[A-Z0-9]{10}", value)) and value not in ("0000000000", "YOURTEAMID")
+
+
+def check():
+    config = read_config()
+    manifest = json.loads((HERE / "upstream.json").read_text(encoding="utf-8"))
+    missing = [entry["path"] for entry in manifest["submodules"] if not any((ROOT / entry["path"]).glob("*"))]
+    return {
+        "native_source": "TelegramMessenger/Telegram-iOS",
+        "upstream_commit": manifest["commit"],
+        "upstream_version": json.loads((ROOT / "versions.json").read_text())["app"],
+        "host": platform.system(),
+        "mac_required_for_build": True,
+        "xcode_available": sys.platform == "darwin" and shutil.which("xcrun") is not None,
+        "required_xcode": json.loads((ROOT / "versions.json").read_text())["xcode"],
+        "api_configured": valid_credentials(config),
+        "apple_team_configured": valid_team(config),
+        "missing_submodules": missing,
+        "native_compilation_verified": False,
+        "device_ui_verified": False,
+        "virtual_gifts_ported": False,
+    }
+
+
+def configure(args):
+    config = read_config()
+    if os.environ.get("TELEGRAM_API_ID"):
+        config["api_id"] = os.environ["TELEGRAM_API_ID"]
+    if os.environ.get("TELEGRAM_API_HASH"):
+        config["api_hash"] = os.environ["TELEGRAM_API_HASH"]
+    team = args.team_id or os.environ.get("APPLE_TEAM_ID")
+    if team:
+        if not re.fullmatch(r"[A-Z0-9]{10}", team):
+            raise ValueError("Apple Team ID must contain 10 uppercase letters or digits")
+        config["team_id"] = team
+    if args.bundle_id:
+        if not re.fullmatch(r"[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+){2,}", args.bundle_id):
+            raise ValueError("Bundle identifier must use reverse-DNS notation")
+        config["bundle_id"] = args.bundle_id
+    if not valid_credentials(config):
+        raise ValueError("Set TELEGRAM_API_ID and TELEGRAM_API_HASH locally, or copy the existing private configuration file")
+    CONFIG.write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")
+    if sys.platform != "win32":
+        CONFIG.chmod(0o600)
+    print("Private configuration saved; API values are not printed")
+
+
+def require_mac():
+    if sys.platform != "darwin" or shutil.which("xcrun") is None:
+        raise ValueError("Native iOS compilation requires macOS with Xcode; Windows can prepare and inspect this source project")
+
+
+def policy_tests():
+    require_mac()
+    # A disposable UserDefaults suite is used by the test; no Telegram account is opened.
+    with tempfile.TemporaryDirectory(prefix="stargram-native-policy-") as directory:
+        binary = Path(directory) / "policy-tests"
+        subprocess.run([
+            "xcrun", "swiftc", "-warnings-as-errors",
+            str(ROOT / "submodules/TelegramCore/Sources/Network/LocalDemoPolicy.swift"),
+            str(ROOT / "submodules/TelegramUI/Sources/NativePreviewStorage.swift"),
+            str(HERE / "Tests/main.swift"), "-o", str(binary),
+        ], cwd=ROOT, check=True)
+        subprocess.run([str(binary)], cwd=ROOT, check=True)
+
+
+def make_command(args):
+    command = [sys.executable, "build-system/Make/Make.py", "--cacheDir=" + str(HERE / ".cache")]
+    unsigned = getattr(args, "unsigned", False)
+    if args.action == "build":
+        flags = ["--jobs=2", "--local_resources=memory=HOST_RAM*0.6", "--repository_cache=" + str(HERE / ".cache/repository")]
+        if args.target == "simulator" or unsigned:
+            flags.append("--//Telegram:disableProvisioningProfiles")
+        if unsigned:
+            flags += ["--//Telegram:disableExtensions", "--features=disable_legacy_signing", "--define=apple.package_swift_support=no"]
+        command.append("--bazelArguments=" + shlex.join(flags))
+    command += ["generateProject" if args.action == "project" else "build", "--configurationPath=" + str(CONFIG)]
+    if args.signing_dir:
+        command += ["--codesigningInformationPath=" + str(Path(args.signing_dir).resolve())]
+    else:
+        command += ["--xcodeManagedCodesigning"]
+    if args.action == "project":
+        if args.target == "simulator":
+            command.append("--disableProvisioningProfiles")
+    else:
+        command += ["--buildNumber=" + str(args.build_number), "--continueOnError"]
+        command += ["--configuration=" + ("debug_sim_arm64" if args.target == "simulator" else "release_arm64")]
+        command += ["--outputBuildArtifactsPath=" + str(HERE / "build-output" / args.target)]
+    return command
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("action", choices=["check", "configure", "policy-tests", "project", "build"])
+    parser.add_argument("--team-id")
+    parser.add_argument("--bundle-id")
+    parser.add_argument("--target", choices=["simulator", "iphone"], default="simulator")
+    parser.add_argument("--signing-dir", help="Local directory containing your own certs/ and profiles/")
+    parser.add_argument("--build-number", type=int, default=100001)
+    parser.add_argument("--unsigned", action="store_true", help="Build an iPhone IPA for later signing on the installer's own computer; does not bypass iOS signing")
+    parser.add_argument("--print-command", action="store_true", help="Print the build command without running it; no API values are exposed")
+    args = parser.parse_args()
+    if args.action == "check":
+        print(json.dumps(check(), ensure_ascii=False, indent=2))
+        return
+    if args.action == "configure":
+        configure(args)
+        return
+    if args.action == "policy-tests":
+        policy_tests()
+        return
+    if args.unsigned and (args.action != "build" or args.target != "iphone"):
+        raise ValueError("--unsigned is only valid for build --target iphone")
+    command = make_command(args)
+    if args.print_command:
+        print(shlex.join(command))
+        return
+    require_mac()
+    config = read_config()
+    if not CONFIG.is_file() or not valid_credentials(config):
+        raise ValueError("Create configuration.local.json with the configure command before building")
+    if args.target == "iphone" and not args.unsigned and not valid_team(config):
+        raise ValueError("A real Apple Team ID is required for an iPhone build")
+    if args.action == "build" and args.target == "iphone" and not args.unsigned and not args.signing_dir:
+        raise ValueError("A signed IPA needs --signing-dir with your certificates and provisioning profiles; use project --target iphone for Xcode-managed development")
+    if check()["missing_submodules"]:
+        raise ValueError("Pinned source submodules are missing; use the native kit Bootstrap.py")
+    if args.build_number < 1:
+        raise ValueError("Build number must be positive")
+    policy_tests()
+    subprocess.run(command, cwd=ROOT, check=True)
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except (ValueError, OSError) as error:
+        print("Error: " + str(error), file=sys.stderr)
+        sys.exit(2)
+    except subprocess.CalledProcessError as error:
+        print("Native build/check failed; no successful IPA is claimed", file=sys.stderr)
+        sys.exit(error.returncode or 1)
